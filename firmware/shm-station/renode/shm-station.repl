// Estación SD: STM32H743 de Renode 1.16.1 más lo que nuestra placa necesita.
using "platforms/cpus/stm32h743.repl"

// El firmware arranca con el HSI a 64 MHz y sin PLL (config.h); la descripción
// de Renode supone 96 MHz. Sin esto, el chip muestrearía a 300 Hz.
nvic:
    systickFrequency: 64_000_000

// La descripción de Renode no trae SPI1 (sí SPI4). Dirección: RM0433.
// El firmware lo atiende por sondeo, así que no se conecta su interrupción.
spi1: SPI.STM32H7_SPI @ sysbus 0x40013000

adxl355: Sensors.ADXL355_SHM @ spi1

{
  "name": "embedverse-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && tsc -p tsconfig.agent-team.json && vite build",
    "agent:start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-agent-team.ps1",
    "agent:runtime": "tsc -p tsconfig.agent-runtime.json && node .agent-runtime/server/agentTeam/main.js",
    "agent:ui": "vite --host 127.0.0.1 --port 5174 --strictPort",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "agent:start:mac": "sh scripts/start-agent-team.sh"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "avr8js": "^0.21.1",
    "lucide-react": "^1.67.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.187.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.7",
    "oxlint": "^1.89.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "description": "Local-first embedded systems design workspace",
  "overrides": {
    "dompurify": "^3.4.17"
  }
}
